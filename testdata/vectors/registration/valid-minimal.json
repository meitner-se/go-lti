{
  "description": "Only the members LTI requires.",
  "request": {
    "response_types": [
      "id_token"
    ],
    "grant_types": [
      "implicit",
      "client_credentials"
    ],
    "initiate_login_uri": "https://client.example.org/lti",
    "redirect_uris": [
      "https://client.example.org/callback",
      "https://client.example.org/callback2"
    ],
    "client_name": "Virtual Garden",
